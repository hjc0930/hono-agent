NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Comma-separated browser origins permitted to call /api/*.
CORS_ORIGINS=
# Reserved for database-backed modules. Do not use a production connection string here.
DATABASE_URL=
# HS256 signing key for access tokens; at least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=
# Access/refresh token lifetimes in seconds.
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
# Initial admin bootstrap for `pnpm run db:seed`. The password value is never logged.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

NODE_ENV=development
PORT=3000
# Total time allowed for HTTP draining, database closure, and log flushing.
SHUTDOWN_TIMEOUT_MS=10000
LOG_LEVEL=info
# Comma-separated browser origins permitted to call /api/*.
CORS_ORIGINS=
# Database engine: postgres or pglite. Unset infers from DATABASE_URL
# (URL-shaped value -> postgres, otherwise embedded PGlite).
DATABASE_TYPE=
# PostgreSQL connection string when using postgres, or the embedded PGlite
# data directory when using pglite. Leave empty for local development, which
# uses embedded PGlite persisted under .data/pglite.
DATABASE_URL=
# HS256 signing key for access tokens; at least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=
# Access/refresh token lifetimes in seconds.
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
# Login brute-force protection.
AUTH_MAX_LOGIN_FAILURES=5
AUTH_LOCKOUT_SECONDS=900
AUTH_IP_FAILURE_LIMIT=20
AUTH_IP_WINDOW_SECONDS=900

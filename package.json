{
  "name": "hono-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:e2e": "vitest run test",
    "test:watch": "vitest src",
    "build": "tsup",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "1.6.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.3",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}

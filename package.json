{
  "name": "hono-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "tsc --build tsconfig.build.json --clean && tsc --project tsconfig.build.json",
    "dev": "concurrently --kill-others --names tsc,node \"tsc --project tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --watch-preserve-output --enable-source-maps dist/server.js\"",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:e2e": "vitest run test",
    "test:watch": "vitest src",
    "build": "tsc --build tsconfig.build.json --clean && tsc --project tsconfig.build.json",
    "start": "node --enable-source-maps dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@hono/node-server": "2.1.1",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "1.6.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.3",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "8.23.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
